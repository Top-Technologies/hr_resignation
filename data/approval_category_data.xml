<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="approval_category_resignation" model="approval.category">
            <field name="name">Resignation</field>
            <field name="description">Employee Resignation Requests</field>
            <field name="sequence">10</field>
            <field name="approval_minimum">1</field>
            <field name="invalid_minimum">1</field>
            <field name="manager_approval" eval="False"/>
            <!-- Important: Do not require unnecessary fields to simplify flow -->
            <field name="has_date">required</field>
            <field name="has_period">no</field>
            <field name="has_quantity">no</field>
            <field name="has_amount">no</field>
            <field name="has_reference">no</field>
            <field name="has_partner">no</field>
            <field name="has_payment_method">no</field>
            <field name="has_location">no</field>
        </record>
    </data>
</odoo>
